{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "devCommand": "pnpm exec vite --config vite.static.config.ts",
  "buildCommand": "pnpm run build:static",
  "outputDirectory": "static-dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/pasc-large-worker.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [{
        "type": "queue/v2beta",
        "topic": "pasc-large-jobs",
        "retryAfterSeconds": 30,
        "initialDelaySeconds": 0
      }]
    }
  }
}
