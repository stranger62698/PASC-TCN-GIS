# AI region interpretation. Secrets are server-only; never prefix them with NEXT_PUBLIC_.
AI_PROVIDER=bailian
AI_ALLOW_ANONYMOUS=false
AI_ALLOW_PERSONAL_ANONYMOUS=true

# Alibaba Cloud Model Studio / Bailian (default provider)
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen3.8-flash
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Official DeepSeek API (set AI_PROVIDER=deepseek to switch)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Existing optional services
NEXT_PUBLIC_TIANDITU_KEY=
PASC_SERVICE_BASE_URL=
PASC_SERVICE_API_KEY=
PASC_CONSUMER_API_KEY=
PASC_WEBGIS_BASE_URL=
PASC_CONSUMER_WORKER_ID=consumer-01
PASC_CONSUMER_LEASE_SECONDS=300

# RoadOps driving route service. Keep the real key in ignored .env.local only.
DIDI_MAP_WEB_SERVICE_KEY=
DIDI_ROUTE_DAILY_BUDGET=50
DIDI_ROUTE_PER_USER_DAILY_LIMIT=20
DIDI_ROUTE_QPS_LIMIT=1
DIDI_ROUTE_CACHE_TTL_SECONDS=1800
DIDI_ROUTE_MAX_MATRIX_POINTS=8
DIDI_ROUTE_MAX_CANDIDATES=10

# Optional RoadOps Phase 2 semantic review. Server-only; deterministic rules work without it.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
